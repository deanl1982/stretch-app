# Terraform working files
.terraform/
.terraform.lock.hcl.bak

# State - should live in the remote backend, never in git.
# If you switch to local state, these MUST stay ignored: the state file
# contains the Static Web App deployment API key in plaintext.
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info

# Real variable and backend values
terraform.tfvars
*.auto.tfvars
backend.hcl

# Plan artefacts
*.tfplan
tfplan
crash.log
crash.*.log

# NOTE: .terraform.lock.hcl is deliberately NOT ignored - commit it so CI
# resolves the exact same provider build you tested with.
