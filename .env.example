# Development gate on the whole app. Set to false to make the site public.
VITE_REQUIRE_LOGIN=true

# SHA-256 of the admin password. Optional — defaults to the hash baked into
# src/auth/gate.ts. Generate a new one with:
#   node -e "console.log(require('crypto').createHash('sha256').update('your-password').digest('hex'))"
# VITE_ADMIN_PASSWORD_HASH=
